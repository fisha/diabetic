#!/usr/bin/env bash
# Stedio on Fly.io (org "stedio", region fra; Guy, 16 Nov 2026). Run on Guy's Mac from the repository clone.
# Never prints a secret value. Never touches any other Fly org or app (mixmaster's are left alone).
#
#   stedio-fly setup        Create the three apps and their volumes (idempotent), and the database password
#   stedio-fly secrets      Fill missing API secrets on stedio-api from services/api/.env (never overwrites one)
#   stedio-fly deploy-db    Deploy PostgreSQL (stedio-db)
#   stedio-fly deploy-api [--trial]   Back up the database, then deploy the API. --trial: the background worker is OFF
#                           (no CareLink/Libre/Tandem syncs, pushes or alerts), so it can run beside the Mac safely
#   stedio-fly deploy-web   Stage the tester install files with the new address and install/latest.json (the newest
#                           build number the API offers to older installs, PM-217), then deploy the website
#   stedio-fly copy-data    Copy the Mac's database and meal photos/exports to Fly (overwrites Fly's copy)
#   stedio-fly backup       Take a database backup now (on the database volume; keeps the newest 10, PM-261)
#   stedio-fly status       Machines, volumes and health of the three apps
#   stedio-fly research-setup   Create stedio-research, its read-only database login (new password each run) and its
#                           secrets; then run deploy-research
#   stedio-fly deploy-research  Deploy the research tool (Streamlit; stops when idle) and check it is closed and noindex
#   stedio-fly evals [--quick] [--repeat N] [--model M]   Run the companion's regression set (PM-198) on Fly: a one-off Machine
#                           in stedio-api with the app's own OpenAI key, synthetic cases only; prints and saves the
#                           verdict, then removes the Machine (PM-203). Run by hand, suggested at the end of a day with
#                           many companion changes (Guy, 23 Nov 2026, PM-436); deploy-api does not run it
#
# Cutover (once the trial looks right): stop the Mac's API, `copy-data`, `deploy-api` (worker on), then switch the app (OTA).

set -euo pipefail
# No `grep -q` after a pipe: it exits early, the writer gets SIGPIPE and pipefail turns a match into a failure.

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
ORG="stedio"
REGION="fra"
DB_APP="stedio-db"
API_APP="stedio-api"
WEB_APP="stedio-web"
RESEARCH_APP="stedio-research"
# Public addresses on stedio.io (Cloudflare DNS, Fly certificates; PM-451). The *.fly.dev names keep working.
WEB_URL="https://stedio.io"
API_URL="https://api.stedio.io"
API_ENV="$REPO/services/api/.env"
BUILDS_INSTALL="${STEDIO_INSTALL_DIR:-/Volumes/Studio SSD/Workspace/steady-builds/install}"
BACKUPS="${STEDIO_BACKUP_DIR:-/Volumes/Studio SSD/Workspace/steady-db-backups}"
MAC_DB_CONTAINER="steady-db-1"
OLD_WEB_HOST="stedio.ngrok.dev"

say() { printf '==> %s\n' "$*"; }
die() { printf 'stedio-fly: %s\n' "$*" >&2; exit 1; }
command -v fly >/dev/null || die "flyctl is not installed"

app_exists() { fly status -a "$1" >/dev/null 2>&1 || fly apps list --org "$ORG" 2>/dev/null | awk '{print $1}' | grep -x "$1" >/dev/null; }
has_secret() { fly secrets list -a "$1" --json 2>/dev/null | grep "\"$2\"" >/dev/null; }
has_volume() { fly volumes list -a "$1" --json 2>/dev/null | grep "\"name\": *\"$2\"" >/dev/null; }

dotenv_get() { # <key>: the value from services/api/.env, unquoted; fails when unset or empty
  local line val
  [ -f "$API_ENV" ] || return 1
  line="$(grep -E "^[[:space:]]*$1=" "$API_ENV" | tail -n 1 || true)"
  [ -n "$line" ] || return 1
  val="${line#*=}"
  val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
  if [ "${#val}" -ge 2 ]; then case "$val" in \"*\") val="${val:1:${#val}-2}" ;; \'*\') val="${val:1:${#val}-2}" ;; esac; fi
  [ -n "$val" ] || return 1
  printf '%s' "$val"
}

cmd_setup() {
  for app in "$DB_APP" "$API_APP" "$WEB_APP"; do
    if app_exists "$app"; then say "$app exists"; else say "creating $app in org $ORG"; fly apps create "$app" --org "$ORG"; fi
  done
  # Daily volume snapshots are on by default; keep 30 days of them for the database (health data), 14 for photos.
  has_volume "$DB_APP" stedio_db || fly volumes create stedio_db -a "$DB_APP" -r "$REGION" -s 1 --snapshot-retention 30 -y
  has_volume "$API_APP" stedio_media || fly volumes create stedio_media -a "$API_APP" -r "$REGION" -s 1 --snapshot-retention 14 -y
  if has_secret "$DB_APP" POSTGRES_PASSWORD; then
    say "database password already set (left as is)"
  else
    say "creating the database password (not shown) on $DB_APP and the matching STEADY_DATABASE_URL on $API_APP"
    local pw; pw="$(openssl rand -hex 24)"
    printf 'POSTGRES_PASSWORD=%s\n' "$pw" | fly secrets import -a "$DB_APP" --stage >/dev/null
    printf 'STEADY_DATABASE_URL=postgresql+psycopg://steady:%s@%s.internal:5432/steady\n' "$pw" "$DB_APP" | fly secrets import -a "$API_APP" --stage >/dev/null
    unset pw
  fi
}

cmd_secrets() {
  [ -f "$API_ENV" ] || die "no $API_ENV"
  local lines="" name value staged=0
  # Copied as they are. STEADY_JWT_SECRET must be the Mac's own: it also unlocks sealed data (CareLink sign-ins, photos).
  for name in STEADY_JWT_SECRET STEADY_SEALING_KEY STEADY_OPENAI_API_KEY STEADY_USDA_API_KEY STEADY_ADMIN_EMAILS \
              STEADY_GOOGLE_CLIENT_IDS STEADY_APPLE_AUDIENCES STEADY_SMTP_HOST STEADY_SMTP_PORT STEADY_SMTP_USER \
              STEADY_SMTP_PASSWORD STEADY_SMTP_FROM STEADY_APP_LATEST_BUILD STEADY_APNS_KEY_ID STEADY_APNS_SANDBOX \
              STEADY_OPENAI_MODEL STEADY_OPENAI_REASONING_EFFORT STEADY_RANKER_MODE STEADY_RANKER_TESTERS STEADY_REQUIRE_APPROVAL \
              STEADY_ALLOW_EMAIL_SIGN_UP STEADY_REQUIRE_EMAIL_VERIFICATION; do
    value="$(dotenv_get "$name" || true)"
    [ -n "$value" ] || continue
    if has_secret "$API_APP" "$name"; then echo "OK     $name already on $API_APP (left as is)"; continue; fi
    lines+="$name=$value"$'\n'; staged=$((staged + 1)); echo "STAGE  $name"
  done
  # The APNs key file becomes one base64 line (services/api/deploy/start.sh writes it back to a file).
  if ! has_secret "$API_APP" STEADY_APNS_KEY_P8_B64; then
    local keypath; keypath="$(dotenv_get STEADY_APNS_KEY_PATH || true)"
    case "$keypath" in /*) ;; ?*) keypath="$REPO/services/api/$keypath" ;; esac
    if [ -n "$keypath" ] && [ -f "$keypath" ]; then
      lines+="STEADY_APNS_KEY_P8_B64=$(base64 < "$keypath" | tr -d '\n')"$'\n'; staged=$((staged + 1)); echo "STAGE  STEADY_APNS_KEY_P8_B64 (from the APNs key file)"
    else
      echo "WARN   no APNs key file: Live Activity pushes stay off"
    fi
  fi
  # The tester install page moves with the website.
  if ! has_secret "$API_APP" STEADY_APP_INSTALL_URL; then
    lines+="STEADY_APP_INSTALL_URL=$WEB_URL/install/index.html"$'\n'; staged=$((staged + 1)); echo "STAGE  STEADY_APP_INSTALL_URL"
  fi
  if [ "$staged" -gt 0 ]; then printf '%s' "$lines" | fly secrets import -a "$API_APP" --stage >/dev/null; fi
  unset lines value
  echo "Skipped on purpose: STEADY_DATABASE_URL (setup), STEADY_CORS_ORIGINS and STEADY_APNS_TEAM_ID (deploy/fly/api/fly.toml), STEADY_APNS_KEY_PATH (start.sh)."
  say "$staged secret(s) staged; they apply on the next deploy-api"
}

cmd_deploy_db() {
  fly deploy "$REPO/deploy/fly/db" -c "$REPO/deploy/fly/db/fly.toml" --dockerfile "$REPO/deploy/fly/db/Dockerfile" --ha=false --remote-only
}

cmd_backup() {
  app_exists "$DB_APP" || die "$DB_APP does not exist"
  fly ssh console -a "$DB_APP" -C stedio-backup
}

# The companion (PM-198): its prompt, tools, safety filter and judge, the settings that pick the model, and everything
# that feeds its instructions (conversation.instructions reads routine, findings, app_data, glucose_now, openers... and
# the models they read). PM-424 showed a list of files misses changes, so any API code counts except the few paths
# below that never reach the companion. When in doubt, leave a path in: an extra eval run costs minutes, a missed one
# ships an untested companion.
COMPANION_PATHS=(
  steady_api
  ':(exclude)steady_api/fonts'
  ':(exclude)steady_api/demo'
  ':(exclude)steady_api/*.NOTICE'
  ':(exclude)steady_api/carelink_messages.json'
  ':(exclude)steady_api/forecast_train.py'
  ':(exclude)steady_api/clinic_report.py'
  ':(exclude)steady_api/routers/admin.py'
  ':(exclude)steady_api/routers/app_version.py'
  ':(exclude)steady_api/routers/metrics.py'
)
EVALS_DIR="$REPO/evals/reports/fly"
LOGPREFIX='s/^[^ ]* app\[[^]]*\] [a-z0-9]* \[[a-z]*\] *//' # fly logs: "<time> app[<machine>] <region> [info]"

# Cost (PM-436, Guy 23 Nov 2026): the regression set is not a deploy gate any more. Run it by hand: `--quick` runs the
# safety cases (hard, dose_boundary, minors) once with the judge reading the reply without the companion's whole
# prompt; `--repeat 3` runs the full set. A passing run records the companion's fingerprint, so deploy-api can say
# whether the deployed companion was tested.

companion_fingerprint() { # one hash of every file in COMPANION_PATHS at the api checkout's HEAD
  git -C "$REPO/services/api" ls-files -s -- "${COMPANION_PATHS[@]}" | git hash-object --stdin
}

companion_changed() { # true unless this exact companion (or the last passing commit's) already passed
  grep -qxF "$(companion_fingerprint)" "$EVALS_DIR/passed-fingerprints" 2>/dev/null && return 1
  local last; last="$(cat "$EVALS_DIR/last-pass" 2>/dev/null || true)"
  [ -z "$last" ] && return 0
  git -C "$REPO/services/api" cat-file -e "$last^{commit}" 2>/dev/null || return 0
  ! git -C "$REPO/services/api" diff --quiet "$last" HEAD -- "${COMPANION_PATHS[@]}"
}

cmd_evals() {
  local repeat=3 model="" quick=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --repeat) repeat="$2"; shift 2 ;;
      --quick) quick=1; shift ;;
      --model) model="$2"; shift 2 ;;
      *) die "evals: unknown option $1" ;;
    esac
  done
  app_exists "$API_APP" || die "$API_APP does not exist"
  has_secret "$API_APP" STEADY_OPENAI_API_KEY || die "$API_APP has no STEADY_OPENAI_API_KEY secret"
  [ -z "$(git -C "$REPO" status --porcelain -- evals services/api/steady_api)" ] || die "evals: commit or stash local changes to evals/ and services/api first (the run must match a commit)"
  local api_sha root_sha tag stamp name id
  api_sha="$(git -C "$REPO/services/api" rev-parse HEAD)"
  local fingerprint; fingerprint="$(companion_fingerprint)" # of the snapshot built below, not of a later checkout
  root_sha="$(git -C "$REPO" rev-parse --short HEAD)"
  tag="evals-${api_sha:0:7}-$root_sha"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  name="evals-$stamp"
  say "building the evals image $tag (synthetic cases + the companion at api ${api_sha:0:7})"
  fly deploy "$REPO" -a "$API_APP" -c "$REPO/deploy/fly/evals/fly.toml" --dockerfile "$REPO/deploy/fly/evals/Dockerfile" \
    --ignorefile "$REPO/deploy/fly/evals/Dockerfile.dockerignore" --build-only --push --image-label "$tag" --remote-only
  say "running the regression set on a one-off Machine ($name); this takes a while"
  local env=(-e "EVAL_REPEAT=$repeat" -e "EVAL_LABEL=fly-$tag" -e "EVAL_QUICK=$quick")
  [ -n "$model" ] && env+=(-e "EVAL_MODEL=$model" -e "EVAL_JUDGE=$model")
  # No services and no restart: nothing routes to it, and it stops when the run ends.
  # A just-pushed image can take a moment to be visible to the Machines API (manifest 404): retry a few times.
  local try=1
  until fly machine run "registry.fly.io/$API_APP:$tag" -a "$API_APP" --region "$REGION" --name "$name" \
    --vm-size shared-cpu-1x --vm-memory 1024 --restart no --metadata stedio_role=evals --detach "${env[@]}" >/dev/null; do
    [ "$try" -ge 6 ] && die "evals: could not start the Machine (image registry.fly.io/$API_APP:$tag)"
    echo "WARN   the Machine did not start (try $try of 6); retrying in $((try * 15)) s"
    sleep $((try * 15)); try=$((try + 1))
  done
  EVALS_MACHINE="$(fly machines list -a "$API_APP" --json | python3 -c 'import json,sys; n=sys.argv[1]; print(next(m["id"] for m in json.load(sys.stdin) if m.get("name")==n))' "$name")"
  id="$EVALS_MACHINE" # global, so the EXIT trap still sees it after this function returns
  trap 'fly machine destroy "$EVALS_MACHINE" -a "$API_APP" --force >/dev/null 2>&1 || true' EXIT
  local state="" waited=0
  while [ "$waited" -lt 5400 ]; do
    state="$(fly machines list -a "$API_APP" --json | python3 -c 'import json,sys; i=sys.argv[1]; print(next((m["state"] for m in json.load(sys.stdin) if m["id"]==i), "destroyed"))' "$id")"
    case "$state" in stopped|destroyed|failed) break ;; esac
    sleep 30; waited=$((waited + 30))
  done
  case "$state" in stopped|destroyed|failed) ;; *) die "evals: the Machine did not finish in 90 minutes" ;; esac
  sleep 10 # let the last log lines ship
  # Plain text: no colour codes in what is parsed and saved.
  local log; log="$(NO_COLOR=1 fly logs -a "$API_APP" --machine "$id" --no-tail 2>/dev/null | sed $'s/\x1b\\[[0-9;]*m//g')"
  mkdir -p "$EVALS_DIR"
  local out="$EVALS_DIR/$stamp-$tag.json"
  printf '%s\n' "$log" | grep 'EVALS_VERDICT ' | tail -1 | sed -e "$LOGPREFIX" -e 's/^.*EVALS_VERDICT //' | python3 -m json.tool > "$out" 2>/dev/null || true
  fly machine destroy "$id" -a "$API_APP" --force >/dev/null 2>&1 || true
  local fails="$EVALS_DIR/$stamp-$tag.failures.jsonl"
  printf '%s\n' "$log" | sed -n '/EVALS_FAILURES_BEGIN/,/EVALS_FAILURES_END/p' | sed -e '1d' -e '$d' -e "$LOGPREFIX" > "$fails"
  [ -s "$fails" ] && say "failing turns (synthetic cases): ${fails#"$REPO"/}" || rm -f "$fails"
  local code; code="$(printf '%s\n' "$log" | grep -o 'EVALS_EXIT=[0-9]*' | tail -1 | cut -d= -f2)"
  printf '%s\n' "$log" | grep -E 'EVALS_(START|ERROR|STDERR)' | sed -e "$LOGPREFIX" || true
  [ -s "$out" ] && cat "$out" || rm -f "$out"
  case "$code" in
    0) echo "$api_sha" > "$EVALS_DIR/last-pass"
       echo "$fingerprint" >> "$EVALS_DIR/passed-fingerprints"
       [ "$repeat" -ge 3 ] && [ "$quick" = 0 ] && echo "$api_sha $(date -u +%s)" > "$EVALS_DIR/last-full-pass"
       say "regression set PASSED (verdict: ${out#"$REPO"/})" ;;
    1) say "regression set FAILED a hard rule (verdict: ${out#"$REPO"/})"; return 1 ;;
    *) say "regression set did not run (exit ${code:-unknown}); see above"; return 2 ;;
  esac
}

cmd_deploy_api() {
  local extra=()
  if [ "${1:-}" = "--trial" ]; then extra=(-e STEADY_RUN_WORKER=false); say "trial: the worker is off"; fi
  # No regression run on deploy (Guy, 23 Nov 2026, PM-436): the set runs by hand (`stedio-fly evals`), suggested to
  # Guy near the end of a day with many companion changes. The deploy only says when the companion is untested.
  if companion_changed; then
    echo "NOTE   the companion changed since the last passing regression run; suggest \`stedio-fly evals\` at the end of the day"
  fi
  # A backup before every deploy: the release command runs migrations.
  if fly status -a "$DB_APP" 2>/dev/null | grep started >/dev/null; then say "database backup first"; cmd_backup; fi
  fly deploy "$REPO/services/api" -c "$REPO/deploy/fly/api/fly.toml" --dockerfile "$REPO/services/api/Dockerfile" \
    --ignorefile "$REPO/services/api/.dockerignore" --ha=false --remote-only ${extra[@]+"${extra[@]}"}
  # Read from the Machine config (ssh is often not ready right after a deploy).
  echo "worker setting on the running Machine: $(fly machines list -a "$API_APP" --json | python3 -c 'import json,sys; print(",".join(m["config"].get("env",{}).get("STEADY_RUN_WORKER","unset") for m in json.load(sys.stdin)))')"
  curl -fsS -m 15 --retry 8 --retry-delay 5 --retry-all-errors "$API_URL/health" && echo
}

# install/latest.json: the newest build number, read by the API's GET /app/version so an older install offers the new
# one without a `fly secrets set` per build (PM-217). From the IPA name (stedio-<version>-<build>.ipa), else from the
# install folder's release.json ("build"). Without a number no file is written and the API uses STEADY_APP_LATEST_BUILD.
# Android (PM-218) counts its builds apart: the staged APK's name (stedio-<version>-<build>.apk) adds an "android" entry,
# {"build": N, "version": "..."}; the top-level "build" stays the iPhone's, so older APIs keep reading it.
write_latest_json() { # <stage dir> <ipa name> <apk name>
  python3 - "$1" "${2:-}" "$BUILDS_INSTALL/release.json" "${3:-}" <<'PY'
import json, re, sys
stage, ipa, release, apk = sys.argv[1:5]
android = None
a = re.fullmatch(r"stedio-(\d+\.\d+\.\d+)-(\d+)\.apk", apk)
if a:
    android = {"build": int(a.group(2)), "version": a.group(1)}
build = version = None
m = re.fullmatch(r"stedio-(\d+\.\d+\.\d+)-(\d+)\.ipa", ipa)
if m:
    version, build = m.group(1), int(m.group(2))
else:
    try:
        with open(release) as f:
            r = json.load(f)
        b = r.get("build")
        if isinstance(b, str) and b.isdigit():
            b = int(b)
        if isinstance(b, int) and not isinstance(b, bool) and b > 0:
            build, version = b, r.get("version") if isinstance(r.get("version"), str) else None
    except (OSError, ValueError, AttributeError):
        pass
if build is None and android is None:
    print("WARN   no build number in the IPA name or release.json: no latest.json, the API uses STEADY_APP_LATEST_BUILD")
    sys.exit(0)
out = {"build": build, "version": version}
if android:
    out["android"] = android
with open(f"{stage}/latest.json", "w") as f:
    json.dump(out, f)
    f.write("\n")
print(f"latest build published: {build} ({version or 'version unknown'})")
if android:
    print(f"latest Android build published: {android['build']} ({android['version']})")
PY
}

cmd_deploy_web() {
  local stage="$REPO/deploy/fly/web/.install"
  rm -rf "$stage"; mkdir -p "$stage"
  if [ -d "$BUILDS_INSTALL" ]; then
    # Only the newest IPA and its page; the address inside them becomes this site's.
    cp -L "$BUILDS_INSTALL"/index.html "$BUILDS_INSTALL"/manifest.plist "$stage"/
    local ipa; ipa="$(grep -o '[^/]*\.ipa' "$stage/manifest.plist" | head -1)"
    [ -n "$ipa" ] && cp -L "$BUILDS_INSTALL/$ipa" "$stage"/
    sed -i '' "s#https://$OLD_WEB_HOST#$WEB_URL#g" "$stage/index.html" "$stage/manifest.plist"
    # The newest Android APK (PM-218), named stedio-<version>-<build>.apk; the highest build number wins.
    local apk; apk="$(cd "$BUILDS_INSTALL" && ls stedio-*-*.apk 2>/dev/null | sed -E 's/^stedio-[0-9.]+-([0-9]+)\.apk$/\1 &/' | sort -n | tail -1 | cut -d' ' -f2)"
    [ -n "$apk" ] && cp -L "$BUILDS_INSTALL/$apk" "$stage"/
    write_latest_json "$stage" "$ipa" "$apk"
    say "install files staged: $(ls "$stage" | tr '\n' ' ')"
  else
    echo "WARN   $BUILDS_INSTALL not found: the website goes up without the tester install page"
  fi
  fly deploy "$REPO" -c "$REPO/deploy/fly/web/fly.toml" --dockerfile "$REPO/deploy/fly/web/Dockerfile" \
    --ignorefile "$REPO/.dockerignore" --ha=false --remote-only
}

cmd_copy_data() {
  docker inspect "$MAC_DB_CONTAINER" >/dev/null 2>&1 || die "the Mac database container $MAC_DB_CONTAINER is not running"
  mkdir -p "$BACKUPS"
  local stamp; stamp="$(date -u +%Y%m%dT%H%MZ)"
  local dump="$BACKUPS/steady-to-fly-$stamp.dump"
  say "dumping the Mac database to $dump"
  docker exec "$MAC_DB_CONTAINER" pg_dump -U steady -d steady -Fc -Z 6 > "$dump"
  docker exec -i "$MAC_DB_CONTAINER" pg_restore -l < "$dump" > /dev/null
  say "backing up whatever Fly has now, then replacing it"
  cmd_backup
  fly ssh sftp put "$dump" /data/backups/incoming.dump -a "$DB_APP"
  # POSTGRES_USER (steady) is the superuser in the official image. --force closes the API's open connections.
  fly ssh console -a "$DB_APP" -C 'sh -c "chown postgres /data/backups/incoming.dump && su postgres -c \"dropdb -U steady -h /var/run/postgresql --if-exists --force steady && createdb -U steady -h /var/run/postgresql steady && pg_restore -U steady -h /var/run/postgresql -d steady --no-owner --exit-on-error /data/backups/incoming.dump\" && rm /data/backups/incoming.dump"'
  local media="$REPO/services/api/media"
  if [ -d "$media" ]; then
    local tgz="$BACKUPS/media-to-fly-$stamp.tgz"
    say "copying meal photos and exports ($(du -sh "$media" | cut -f1))"
    COPYFILE_DISABLE=1 tar --no-xattrs -C "$REPO/services/api" -czf "$tgz" media
    fly ssh sftp put "$tgz" /data/media-incoming.tgz -a "$API_APP"
    fly ssh console -a "$API_APP" -C 'sh -c "rm -rf /data/media && tar -xzf /data/media-incoming.tgz -C /data && chown -R steady:steady /data/media && rm /data/media-incoming.tgz"'
    rm -f "$tgz"
  fi
  say "copied. Restart the API so it starts clean: fly machine restart -a $API_APP"
}

cmd_status() {
  for app in "$DB_APP" "$API_APP" "$WEB_APP"; do echo "--- $app"; fly status -a "$app" 2>&1 | sed -n '1,20p'; done
  echo "--- volumes"; fly volumes list -a "$DB_APP"; fly volumes list -a "$API_APP"
  echo "--- health"; curl -s -m 10 -o /dev/null -w "api %{http_code}\n" "$API_URL/health"; curl -s -m 20 -o /dev/null -w "web %{http_code}\n" "$WEB_URL/he"
}

cmd_research_setup() {
  app_exists "$DB_APP" || die "$DB_APP does not exist"
  [ -f "$API_ENV" ] || die "no $API_ENV"
  if app_exists "$RESEARCH_APP"; then say "$RESEARCH_APP exists"; else say "creating $RESEARCH_APP in org $ORG"; fly apps create "$RESEARCH_APP" --org "$ORG"; fi
  # Its own database login (deploy/fly/research/role.sql): a new password every run, so it is never needed again.
  # The SQL goes over as a file (not on a command line) and is removed right after.
  local pw tmp; pw="$(openssl rand -hex 24)"; tmp="$(mktemp)"
  ( umask 077; { printf "\\set pw '%s'\n" "$pw"; cat "$REPO/deploy/fly/research/role.sql"; } > "$tmp" )
  say "creating or updating the stedio_research database login (read-only, need-to-know tables)"
  fly ssh sftp put "$tmp" /data/backups/.research-role.sql -a "$DB_APP" >/dev/null
  rm -f "$tmp"
  fly ssh console -a "$DB_APP" -C 'sh -c "chown postgres /data/backups/.research-role.sql && su postgres -c \"psql -q -U steady -h /var/run/postgresql -d steady -f /data/backups/.research-role.sql\"; rc=\$?; rm -f /data/backups/.research-role.sql; exit \$rc"'
  local lines="" value name
  lines+="STEADY_DATABASE_URL=postgresql+psycopg://stedio_research:$pw@$DB_APP.internal:5432/steady"$'\n'
  unset pw
  # Pseudonyms must match the API's, without giving this server the sealing key or the JWT secret: only the derived key.
  value="$(dotenv_get STEADY_SEALING_KEY || dotenv_get STEADY_JWT_SECRET || true)"
  [ -n "$value" ] || die "no STEADY_SEALING_KEY or STEADY_JWT_SECRET in $API_ENV"
  lines+="STEADY_ML_SUBJECT_KEY=$(K="$value" python3 -c 'import hashlib, os; print(hashlib.sha256(b"steady-ml-subject-v1" + os.environ["K"].encode()).hexdigest())')"$'\n'
  # The API's settings require a JWT secret; this one is the tool's own and signs nothing the API accepts.
  has_secret "$RESEARCH_APP" STEADY_JWT_SECRET || lines+="STEADY_JWT_SECRET=$(openssl rand -hex 32)"$'\n'
  has_secret "$RESEARCH_APP" STEADY_RESEARCH_COOKIE_SECRET || lines+="STEADY_RESEARCH_COOKIE_SECRET=$(openssl rand -hex 32)"$'\n'
  # The same access token as the Mac's local tool; the Google settings once they are in .env.
  for name in STEADY_RESEARCH_TOKEN STEADY_RESEARCH_EMAILS STEADY_RESEARCH_GOOGLE_CLIENT_ID STEADY_RESEARCH_GOOGLE_CLIENT_SECRET \
              STEADY_ADMIN_EMAILS STEADY_RANKER_MODE STEADY_RANKER_TESTERS; do
    value="$(dotenv_get "$name" || true)"
    if [ -n "$value" ]; then lines+="$name=$value"$'\n'; echo "STAGE  $name"; else echo "SKIP   $name (not in .env)"; fi
  done
  printf '%s' "$lines" | fly secrets import -a "$RESEARCH_APP" --stage >/dev/null
  unset lines value
  say "secrets staged on $RESEARCH_APP; run: scripts/fly/stedio-fly deploy-research"
}

cmd_deploy_research() {
  app_exists "$RESEARCH_APP" || die "$RESEARCH_APP does not exist: run research-setup first"
  fly deploy "$REPO/services/api" -c "$REPO/deploy/fly/research/fly.toml" --dockerfile "$REPO/services/api/steady_research/Dockerfile" \
    --ignorefile "$REPO/services/api/steady_research/Dockerfile.dockerignore" --ha=false --remote-only
  local url="https://$RESEARCH_APP.fly.dev"
  curl -fsS -m 30 --retry 8 --retry-delay 5 --retry-all-errors -o /dev/null "$url/_stcore/health"
  curl -fsS -m 30 -D - -o /dev/null "$url/" | grep -i '^x-robots-tag: noindex' >/dev/null || die "the noindex header is missing"
  say "up at $url (stops when idle). Sign-in: $(fly secrets list -a "$RESEARCH_APP" --json | grep STEADY_RESEARCH_GOOGLE_CLIENT_ID >/dev/null && echo Google || echo 'access token')"
}

case "${1:-help}" in
  setup) cmd_setup ;;
  secrets) cmd_secrets ;;
  deploy-db) cmd_deploy_db ;;
  deploy-api) shift; cmd_deploy_api "$@" ;;
  deploy-web) cmd_deploy_web ;;
  copy-data) cmd_copy_data ;;
  backup) cmd_backup ;;
  status) cmd_status ;;
  research-setup) cmd_research_setup ;;
  deploy-research) cmd_deploy_research ;;
  evals) shift; cmd_evals "$@" ;;
  *) sed -n '2,23p' "$0" ;;
esac
